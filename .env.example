# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# Supabase Postgres runtime connection.
# Use the pooled connection string from Supabase for app runtime.
POSTGRES_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase Postgres migration connection.
# Use the direct connection string from Supabase for Drizzle migrations/pushes.
DIRECT_DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Comma-separated trusted web origins for auth and tRPC CORS.
# Include your deployed Next.js URL and any Expo/dev origins you explicitly trust.
ALLOWED_ORIGINS="http://localhost:3000"

# You can generate the secret via 'openssl rand -base64 32' on Unix.
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET=''

# Preconfigured Discord OAuth provider, works out-of-the-box
# @see https://www.better-auth.com/docs/authentication/discord
AUTH_DISCORD_ID=''
AUTH_DISCORD_SECRET=''

# Optional: enables AI-backed onboarding synthesis, curriculum generation, and debriefs.
# AI_PROVIDER can be "google", "openai", or "openrouter". Google is the default.
AI_PROVIDER="google"
GOOGLE_GENERATIVE_AI_API_KEY=''
AI_MODEL_STANDARD='gemini-3.1-flash-lite'
AI_MODEL_CRITICAL='gemini-3.1-flash-lite'
# Search/grounding tools are needed for curriculum quality. They can hit
# separate provider quota paths from normal Gemini model calls.
AI_ENABLE_SEARCH_TOOLS='true'

# Optional per-purpose overrides. Use these to put only onboarding and
# curriculum generation on OpenAI while leaving overview/tutor/workspace on
# the global provider.
# AI_PROVIDER_ONBOARDING='openai'
# AI_PROVIDER_CURRICULUM='openai'
# AI_MODEL_ONBOARDING='gpt-4.1'
# AI_MODEL_CURRICULUM='gpt-4.1'

# Backwards-compatible OpenAI settings. Used when AI_PROVIDER="openai".
OPENAI_API_KEY=''
OPENAI_MODEL='gpt-4.1-mini'

# OpenRouter settings. Used when AI_PROVIDER="openrouter". Defaults to GLM 5.2
# (z-ai/glm-5.2, 1M-token context, tool + reasoning + structured-output support).
# Override the model with AI_MODEL / AI_MODEL_CRITICAL / AI_MODEL_STANDARD or any
# per-purpose AI_MODEL_* var using an OpenRouter slug (e.g. z-ai/glm-5.2).
# OPENROUTER_API_KEY='sk-or-v1-...'
