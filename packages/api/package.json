{
  "name": "@acme/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./onboarding-chat": {
      "types": "./dist/onboarding-chat.d.ts",
      "default": "./src/onboarding-chat.ts"
    },
    "./workspace-chat": {
      "types": "./dist/workspace-chat.d.ts",
      "default": "./src/workspace-chat.ts"
    },
    "./unit-coach": {
      "types": "./dist/unit-coach.d.ts",
      "default": "./src/unit-coach.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@acme/auth": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/validators": "workspace:*",
    "@ai-sdk/google": "^3.0.78",
    "@ai-sdk/openai": "^3.0.47",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@trpc/server": "catalog:",
    "ai": "^6.0.134",
    "effect": "4.0.0-beta.92",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
