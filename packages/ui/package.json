{
  "name": "@acme/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./autocomplete": "./src/autocomplete.tsx",
    "./badge": "./src/badge.tsx",
    "./button": "./src/button.tsx",
    "./chat": "./src/chat/index.ts",
    "./command": "./src/command.tsx",
    "./dropdown-menu": "./src/dropdown-menu.tsx",
    "./field": "./src/field.tsx",
