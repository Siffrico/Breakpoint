    "./label": "./src/label.tsx",
    "./menu": "./src/menu.tsx",
    "./scroll-area": "./src/scroll-area.tsx",
    "./separator": "./src/separator.tsx",
    "./surface": "./src/surface.tsx",
    "./textarea": "./src/textarea.tsx",
